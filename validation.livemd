# Funx: Validator

```elixir
Mix.install([
   {:transaction, path: Path.expand(__DIR__)}                                                   
])
```

## Start

```elixir
alias Funx.Optics.{Lens, Prism}
alias Funx.Validator
alias Funx.Monad.Either

alias Funx.Validator.{
  Any,
  Equal,
  Integer, 
  Positive, 
  Required, 
  In, 
  Negative, 
  Positive, 
  AllEqual, 
  Range, 
  LiftPredicate
}

alias Transaction.User

alias Funx.Optics.{Lens, Prism, Traversal}
alias Funx.Monad.Either

require Logger
use Funx.Monad.Maybe
use Funx.Monad.Either
use Funx.Validate
use Funx.Eq
```

```elixir
eq_by_id =
  eq do
    on :id
  end

Funx.List.uniq(
  [
    %User{id: 1, name: "Jim", age: 21, status: :active},
    %User{id: 1, name: "James", age: 20, status: :active}
  ]
)
```

```elixir
jim = %User{id: 1, age: 20, name: "Jim", status: :active}
beth = %User{id: 2, age: 21, name: "Beth", status: :inactive}
incomplete_user =  %User{id: 1, age: 20, name: nil, status: :active}

users = [jim, beth, incomplete_user]
```

```elixir
Positive.validate(1)
```

```elixir
Positive.validate(-1)
```

```elixir
user_val = 
  validate do
    at :id, Integer
    at :age, Positive
    at :name, Required
    at :status, {In, values: [:active, :inactive] }
  end
```

```elixir
Either.validate(jim, user_val)
```

```elixir
Either.validate(incomplete_user, user_val)
```

Can pass `message` function to any validator

```elixir
user_val = 
  validate do
    at :id, Integer
    at :age, Positive
    at :name, {Required, message: fn _ -> "Name is required" end}
    at :status, [
        {Required, message: fn _ -> "Status is required" end}, 
        {In, values: [:active, :inactive] }
      ]
  end
Either.validate(incomplete_user, user_val)
```

```elixir
unsafe_user =  %{age: 20}
Either.validate(unsafe_user, user_val)
```

It didn't catch the missing "ID". Validations do not run on missing data unless we include Required.  However, if `id` is an invariant (it can NEVER be absent), we can leverage the `Lens` optic

```elixir
user_val = 
  validate do
    at Lens.key(:id), Integer
    at :age, Positive
    at :name, {Required, message: fn _ -> "Name is required" end}
    at :status, [
        {Required, message: fn _ -> "Status is required" end}, 
        {In, values: [:active, :inactive] }
      ]
  end
# Either.validate(unsafe_user, user_val)
```

And it will raise an error.

Can use validators without `at`, such as using `In` to check if the user is part of the user group

```elixir
user_val = 
  validate do
    at Lens.key(:id), Integer
    at :age, Positive
    at :name, {Required, message: fn _ -> "Name is required" end}
    at :status, [
        {Required, message: fn _ -> "Status is required" end}, 
        {In, values: [:active, :inactive] }
      ]
    {In, values: users, message: fn _ -> "Must be an existing user" end }
  end
Either.validate(jim, user_val)
```

```elixir
dave = %User{id: 5, age: 34, name: "Dave", status: :active}
Either.validate(dave, user_val)
```

Dave is not a current user.

What about James?

```elixir
james = %User{id: 1, age: 23, name: "James", status: :active}

Either.validate(james, user_val)
```

Yes. Funx's equality defaults to the Eq protocol. For Users we established they are equal if they share an `id`.  In this case, James is just a different spelling of Jim.

```elixir
james = %User{id: 1, age: 20, name: "James", status: :active}

Either.validate(james, user_val)
```

```elixir
Funx.List.uniq([jim, james])
```

```elixir
slow_val = 
  validate do
    {Slow.Validation, delay_ms: 1500}
  end
# Either.validate(james, slow_val)
```

```elixir
Either.validate(james, slow_val, env: %{db: "conn", user: james.id})
```

Sequence Mode

```elixir
slow_val = 
  validate do
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
  end
# Either.validate(james, slow_val)
```

Parallel Mode

```elixir
parallel_slow_val = 
  validate mode: :parallel do
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
    {Slow.Validation, delay_ms: 400}
  end
# Either.validate(james, parallel_slow_val)
```

Split fast and slow in either execution block

```elixir
use Funx.Monad.Either

# either jim do
#   validate user_val
#   validate [parallel_slow_val]
# end
```

Works like `bind`, will not run expensive validation if first fails

```elixir
# either dave do
#   validate user_val
#   validate [parallel_slow_val]
# end
```

## Compost complex from simple (model complex DDD and Sum type

Here is some data:

```elixir
charge_cc =
  %Transaction{
    id: 1,
    item: %Item{name: "Camera", price: 500},
    type: %Charge{
      payment: %CreditCard{id: 100, name: "Alice", number: "4111", expiry: "12/26", amount: 500},
      status: :pending
    }
  }

invalid_charge_cc =
  %Transaction{
    id: 2,
    item: %Item{name: "Camera", price: 500},
    type: %Charge{
      payment: %CreditCard{id: 101, name: "Alice", number: "4111", expiry: "12/26", amount: 400},
      status: :pending
    }
  }

charge_check =
  %Transaction{
    id: 3,
    item: %Item{name: "Lens", price: 300},
    type: %Charge{
      payment: %Check{id: 102, name: "Bob", routing_number: "111000025", account_number: "987654", amount: 300},
      status: :pending
    }
  }

refund_cc =
  %Transaction{
    id: 4,
    item: %Item{name: "Tripod", price: 150},
    type: %Refund{
      payment: %CreditCard{id: 103, name: "Carol", number: "4333", expiry: "10/27", amount: 150},
      status: :pending
    }
  }

refund_check =
  %Transaction{
    id: 5,
    item: %Item{name: "Flash", price: 200},
    type: %Refund{
      payment: %Check{id: 104, name: "Dave", routing_number: "222000025", account_number: "123456", amount: 200},
      status: :pending
    }
  }

transactions = [charge_cc, charge_check, refund_cc, refund_check]
```

Simple payment type

```elixir
check_val = 
  validate do
    at Lens.key(:id), [Integer, Positive]
    at :name, Required
    at :routing_number, Required
    at :account_number, Required
    at :amount, [Required, Positive]
  end

cc_val = 
  validate do
    at Lens.key(:id), [Integer, Positive]
    at :name, Required
    at :number, Required
    at :expiry, Required
    at :amount, [Required, Positive]
  end
```

Can combine them disjunctively with `Any` validator.

Note: can't use an `any` block because how do we report the failure?

```elixir
payment_val =
  validate do
    at :payment, {
      Any, 
      validators: [check_val, cc_val],
      message: fn  -> "Must be a valid Check or CreditCard" end
    }
    at :status, {In, values: [:pending, :complete]}
  end
```

And the `Item`

```elixir
item_val = 
  validate do
    at :name, Required
    at :price, [Required, Positive]
  end
```

Composing complex from simple. Note that `In` in Funx not just for atoms and strings, it also works for structs:

```elixir
transaction_val = 
  validate do
    at :item, item_val
    at :type, [
      {
        In, 
        values: [Charge, Refund],
        message: fn _ -> "Must be a Charge or Refund" end
      },
      payment_val
    ]
  end

Either.validate(refund_cc, transaction_val)
```

Can validate more complex domain rules.

```elixir
cc_amount_prism = 
  Prism.path([
      {Transaction, :type}, 
      :payment, 
    {CreditCard, :amount}
  ])

price_lens = Lens.path([:item, :price])

amount_trav = Traversal.combine([price_lens, cc_amount_prism])


transaction_val = 
  validate do
    at :item, item_val
    at :type, [
      {
        In, 
        values: [Charge, Refund],
        message: fn _ -> "Must be a Charge or Refund" end
      },
      payment_val
    ]
    at amount_trav, {AllEqual, message: fn _ -> "Amounts must match" end}
  end


Either.validate(refund_cc, transaction_val)
```

`AllEq` uses `Eq` protocol, in this case it is checking two amounts in the transaction extracted with a `Traversal` optic.

```elixir
Either.validate(invalid_charge_cc, transaction_val)
```

Works on all valid transactions:

```elixir
Either.validate(charge_check, transaction_val)
```

The `Any` is disjunctive. But we can add more conjunctive validations.

```elixir
cc_refund_val = 
  validate do
    at Lens.path([:type]),
      {
        Equal, 
        value: Refund,
        message: fn _ -> "Must be a refund" end
      }
    at Lens.path([:type, :payment]),
      {
        Equal, 
        value: CreditCard,
        message: fn _ -> "Must be a credit card" end
      }
  end

Either.validate(refund_cc, [cc_refund_val, transaction_val])
```

`cc_refund_val` validates that the transaction is a `CreditCard` *and* a `Refund`

```elixir
Either.validate(refund_cc, cc_refund_val)
```

We can conjunctively combine `cc_refund_val`, `transaction_val` in the `Either`:

```elixir
Either.validate(refund_cc, [cc_refund_val, transaction_val])
```

Or with the DSL:

```elixir
cc_refund_transaction_val = 
  validate do
    cc_refund_val
    transaction_val
  end
```

```elixir
Either.validate(charge_check, cc_refund_transaction_val)
```

```elixir
Either.validate(invalid_charge_cc, cc_refund_transaction_val)
```
